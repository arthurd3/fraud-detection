# Onda 5 PGO passo 1 — build INSTRUMENTADO (descartável; gera default.iprof
# ao rodar + workload k6). NÃO commitar imagem; só extrair o binário via
# `docker build --target export --output type=local,dest=_pgo .`
# syntax=docker/dockerfile:1
FROM container-registry.oracle.com/graalvm/native-image:21 AS builder
WORKDIR /src
COPY api/ ./api/
RUN cd api && ./mvnw -q -Pnative-instrument -DskipTests package

FROM scratch AS export
COPY --from=builder /src/api/target/api /api-instr

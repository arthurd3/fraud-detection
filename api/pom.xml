<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.fraudDetection</groupId>
    <artifactId>api</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <native.maven.plugin.version>0.10.3</native.maven.plugin.version>
        <main.class>org.fraudDetection.Main</main.class>
    </properties>

    <build>
        <finalName>api</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <!-- Onda 5: jdk.incubator.vector removido (dead code); o
                         compilador não precisa mais do módulo. -->
                    <!-- Rust port (2026-05-30): o binding @CContext/@CFunction usa
                         org.graalvm.nativeimage.c.*, módulo embutido no GraalVM JDK
                         (não precisa de dep graal-sdk externa). -->
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>org.graalvm.nativeimage</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                    <excludes>
                        <exclude>references.json.gz</exclude>
                        <exclude>references.bin</exclude>
                        <exclude>references.kdt</exclude>
                        <exclude>hnsw.bin</exclude>
                        <exclude>hnsw.rbh1.golden</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Onda 5: build nativo FINAL (consome default.iprof via PGO).
             Requer api/default.iprof presente (gerado offline pelo profile
             `native-instrument` + k6 oficial — ver TUTORIAL_NATIVE.md §6). -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <imageName>api</imageName>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <!-- distroless/base-debian12 só tem glibc (sem
                                     libz). GZIPInputStream alcançável → o binário
                                     linka libz dinâmico. Static-except-libc
                                     resolve sem inflar a imagem. -->
                                <buildArg>-H:+StaticExecutableWithDynamicLibC</buildArg>
                                <!-- Rust port (2026-05-30): linka libfdsearch.a (motor
                                     de busca) via a C-interface. CLibraryPath = linker
                                     (acha o .a); CCompilerOption=-I = include (acha o
                                     fdsearch.h na query da @CContext). G0 provou que os
                                     DOIS são necessários. O Dockerfile stage o .a+.h em
                                     /src/api/clib antes do mvnw. -->
                                <buildArg>-H:CLibraryPath=/src/api/clib</buildArg>
                                <buildArg>-H:CCompilerOption=-I/src/api/clib</buildArg>
                                <buildArg>-O3</buildArg>
                                <!-- alvo = Mac Mini Late-2014 Haswell/AVX2 (RINHA_PLAN
                                     §1.7) => x86-64-v3 (NÃO -march=native: builder ≠
                                     alvo; v2 não tem AVX2 e quebraria o Gate A). -->
                                <buildArg>-march=x86-64-v3</buildArg>
                                <buildArg>--gc=serial</buildArg>
                                <!-- Onda 21: heap reservation 64m→48m. Steady-state is
                                     zero-alloc (AllocCheckKd 0 B/100k since Onda 6); peak
                                     boot allocation (load .kdt + topBbox/topSlot) <16 MB.
                                     48m gives >2× headroom. Onda 14 falsified 32m (OOM
                                     boot). Net cgroup pressure reduction: −16 MB. -->
                                <buildArg>-R:MaxHeapSize=48m</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>--pgo=default.iprof</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Onda 5: build INSTRUMENTADO (passo 1 do PGO; gera default.iprof
             ao rodar + workload k6 e receber SIGINT). Sem o flag pgo nem
             heap apertado (a run de treino e descartavel). -->
        <profile>
            <id>native-instrument</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native-instrument</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>${main.class}</mainClass>
                            <imageName>api</imageName>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <!-- instrumentado roda no box de dev (CPU
                                     desconhecido) p/ treinar: compatibility =
                                     roda em qualquer amd64; o .iprof é
                                     reutilizável no build final x86-64-v3. -->
                                <buildArg>-march=compatibility</buildArg>
                                <buildArg>--gc=serial</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>--pgo-instrument</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
